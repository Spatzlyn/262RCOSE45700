{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "생활도로 Track 1 v1.1 review",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1-review"
    },
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "track1": {
      "type": "object",
      "properties": {
        "attributes": {
          "type": "object",
          "properties": {
            "traffic_direction": {
              "type": "string",
              "enum": [
                "One-way",
                "Two-way",
                "Unknown"
              ]
            },
            "direction_match": {
              "type": "string",
              "enum": [
                "Consistent",
                "Conflicting",
                "Unknown",
                "Not applicable"
              ]
            },
            "sidewalk_left": {
              "type": "string",
              "enum": [
                "P",
                "A",
                "U"
              ]
            },
            "sidewalk_right": {
              "type": "string",
              "enum": [
                "P",
                "A",
                "U"
              ]
            }
          },
          "required": [
            "traffic_direction",
            "direction_match",
            "sidewalk_left",
            "sidewalk_right"
          ],
          "additionalProperties": false
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "object_id": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "type": "string",
                "enum": [
                  "car",
                  "truck",
                  "powered_two_wheeler",
                  "bicycle",
                  "pedestrian",
                  "personal_mobility",
                  "other",
                  "traffic_cone",
                  "stored_items",
                  "bag_or_bundle",
                  "speed_bump",
                  "traffic_sign",
                  "traffic_light"
                ]
              },
              "bbox_xyxy_norm": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minItems": 4,
                "maxItems": 4
              },
              "semantic_role": {
                "type": "string",
                "enum": [
                  "actor",
                  "obstacle",
                  "road_feature"
                ]
              },
              "placement": {
                "type": "string",
                "enum": [
                  "roadside",
                  "travel_space",
                  "entrance",
                  "unknown"
                ]
              },
              "truncated": {
                "type": "string",
                "enum": [
                  "P",
                  "A",
                  "U"
                ]
              },
              "location": {
                "type": "string",
                "enum": [
                  "in_D",
                  "adjacent",
                  "outside",
                  "unknown"
                ]
              },
              "orientation": {
                "type": "string",
                "enum": [
                  "same",
                  "opposite",
                  "transverse",
                  "unknown",
                  "not_applicable"
                ]
              }
            },
            "required": [
              "object_id",
              "class",
              "bbox_xyxy_norm",
              "semantic_role",
              "placement",
              "truncated",
              "location",
              "orientation"
            ],
            "additionalProperties": false
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "region_id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "enum": [
                  "connection",
                  "occluded_forward",
                  "occluded_lateral",
                  "bottleneck"
                ]
              },
              "bbox_xyxy_norm": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "polygon_xy_norm": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "minItems": 3
                  },
                  {
                    "type": "null"
